<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Voice Scratchpad</title>
  <style>
    :root {
      --bg: #121212;
      --surface: #1e1e1e;
      --surface-hover: #2a2a2a;
      --border: #333;
      --text: #f0f0f0;
      --muted: #999;
      --accent: #3b82f6;
      --danger: #ef4444;
      --recording: #dc2626;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      height: 100dvh;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      gap: 8px;
    }
    header h1 {
      font-size: 1.1rem;
      margin: 0;
      white-space: nowrap;
    }
    .header-actions {
      display: flex;
      gap: 8px;
    }
    button {
      background: var(--surface-hover);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    button:hover { border-color: #555; }
    button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      font-weight: 600;
    }
    button.record-btn {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff;
      font-weight: 600;
      padding: 10px 18px;
      font-size: 1rem;
    }
    button.record-btn.active {
      background: var(--recording);
      border-color: var(--recording);
      animation: pulse 1.5s infinite;
    }
    button.danger { color: #fca5a5; }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.75; }
    }
    .layout {
      display: flex;
      flex: 1;
      overflow: hidden;
    }
    aside {
      width: 260px;
      background: var(--surface);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    .note-item {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
    }
    .note-item:hover { background: var(--surface-hover); }
    .note-item.active {
      background: #26334d;
      border-left: 3px solid var(--accent);
    }
    .note-item-title {
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .note-item-meta {
      font-size: 0.75rem;
      color: var(--muted);
    }
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 16px;
      gap: 12px;
      overflow: hidden;
    }
    .title-input {
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      font-size: 1.3rem;
      font-weight: 600;
      padding: 6px 0;
      width: 100%;
    }
    .title-input:focus { outline: none; border-bottom-color: var(--accent); }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .status {
      font-size: 0.85rem;
      color: var(--muted);
    }
    .status.listening { color: #f87171; font-weight: 600; }
    textarea {
      flex: 1;
      width: 100%;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px;
      font-size: 1.05rem;
      line-height: 1.6;
      resize: none;
      font-family: inherit;
    }
    textarea:focus { outline: none; border-color: var(--accent); }
    .interim-box {
      min-height: 28px;
      padding: 6px 12px;
      background: #18181b;
      border-radius: 6px;
      font-size: 0.9rem;
      color: #a1a1aa;
      font-style: italic;
    }
    @media (max-width: 700px) {
      .layout { flex-direction: column; }
      aside {
        width: 100%;
        max-height: 140px;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }
    }
  </style>
</head>
<body>

<header>
  <h1>Voice Scratchpad</h1>
  <div class="header-actions">
    <button class="primary" id="newNoteBtn">+ New Note</button>
    <button id="exportAllBtn" title="Download all notes as JSON">Backup All</button>
  </div>
</header>

<div class="layout">
  <aside id="noteList"></aside>
  <main>
    <input type="text" id="noteTitle" class="title-input" placeholder="Note title..." />
    <div class="toolbar">
      <div style="display:flex; align-items:center; gap:10px;">
        <button id="recordBtn" class="record-btn">Start Talking</button>
        <span id="statusText" class="status">Ready</span>
      </div>
      <div style="display:flex; gap:8px;">
        <button id="downloadTxtBtn">Download .txt</button>
        <button id="deleteNoteBtn" class="danger">Delete</button>
      </div>
    </div>
    <div id="interimText" class="interim-box">Live speech preview will appear here...</div>
    <textarea id="noteBody" placeholder="Tap 'Start Talking' to append voice notes, or type directly..."></textarea>
  </main>
</div>

<script>
  const STORAGE_KEY = 'voice_scratchpad_notes_v1';
  let notes = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  let activeId = null;
  let isRecording = false;
  let recognition = null;

  const noteListEl = document.getElementById('noteList');
  const titleEl = document.getElementById('noteTitle');
  const bodyEl = document.getElementById('noteBody');
  const recordBtn = document.getElementById('recordBtn');
  const statusEl = document.getElementById('statusText');
  const interimEl = document.getElementById('interimText');

  function saveNotes() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(notes));
    renderList();
  }

  function createNote() {
    const newNote = {
      id: Date.now().toString(),
      title: 'Note ' + new Date().toLocaleDateString(),
      body: '',
      updated: new Date().toISOString()
    };
    notes.unshift(newNote);
    activeId = newNote.id;
    saveNotes();
    loadActiveNote();
  }

  function loadActiveNote() {
    const note = notes.find(n => n.id === activeId);
    if (!note) return;
    titleEl.value = note.title;
    bodyEl.value = note.body;
    renderList();
  }

  function renderList() {
    noteListEl.innerHTML = '';
    notes.forEach(note => {
      const div = document.createElement('div');
      div.className = 'note-item' + (note.id === activeId ? ' active' : '');
      div.innerHTML = `
        <div class="note-item-title">${escapeHtml(note.title || 'Untitled')}</div>
        <div class="note-item-meta">${new Date(note.updated).toLocaleString()}</div>
      `;
      div.onclick = () => {
        if (isRecording) stopRecording();
        activeId = note.id;
        loadActiveNote();
      };
      noteListEl.appendChild(div);
    });
  }

  function escapeHtml(str) {
    return str.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function updateCurrentNote() {
    const note = notes.find(n => n.id === activeId);
    if (!note) return;
    note.title = titleEl.value;
    note.body = bodyEl.value;
    note.updated = new Date().toISOString();
    saveNotes();
  }

  titleEl.addEventListener('input', updateCurrentNote);
  bodyEl.addEventListener('input', updateCurrentNote);

  document.getElementById('newNoteBtn').onclick = () => {
    if (isRecording) stopRecording();
    createNote();
  };

  document.getElementById('deleteNoteBtn').onclick = () => {
    if (notes.length <= 1) {
      notes[0].body = '';
      notes[0].title = 'Untitled Note';
      saveNotes();
      loadActiveNote();
      return;
    }
    if (isRecording) stopRecording();
    notes = notes.filter(n => n.id !== activeId);
    activeId = notes[0].id;
    saveNotes();
    loadActiveNote();
  };

  document.getElementById('downloadTxtBtn').onclick = () => {
    const note = notes.find(n => n.id === activeId);
    if (!note) return;
    const blob = new Blob([`${note.title}\n\n${note.body}`], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = (note.title || 'note').replace(/[^a-z0-9]/gi, '_') + '.txt';
    a.click();
  };

  document.getElementById('exportAllBtn').onclick = () => {
    const blob = new Blob([JSON.stringify(notes, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'voice-notes-backup-' + new Date().toISOString().slice(0,10) + '.json';
    a.click();
  };

  // Speech Recognition Setup with Auto-Restart Loop
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    statusEl.textContent = 'Speech API not supported in this browser (use Chrome/Edge).';
    recordBtn.disabled = true;
  } else {
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'en-US';

    recognition.onstart = () => {
      statusEl.textContent = 'Listening... (pause anytime to think)';
      statusEl.className = 'status listening';
    };

    recognition.onresult = (event) => {
      let interim = '';
      let finalChunk = '';

      for (let i = event.resultIndex; i < event.results.length; i++) {
        const transcript = event.results[i][0].transcript;
        if (event.results[i].isFinal) {
          finalChunk += transcript;
        } else {
          interim += transcript;
        }
      }

      interimEl.textContent = interim || 'Listening...';

      if (finalChunk) {
        const clean = finalChunk.trim();
        const current = bodyEl.value;
        const needsSpace = current.length > 0 && !/[\s\n]$/.test(current);
        const capitalized = clean.charAt(0).toUpperCase() + clean.slice(1);
        bodyEl.value = current + (needsSpace ? ' ' : '') + capitalized + '.';
        bodyEl.scrollTop = bodyEl.scrollHeight;
        interimEl.textContent = 'Listening...';
        updateCurrentNote();
      }
    };

    recognition.onerror = (event) => {
      if (event.error === 'not-allowed') {
        statusEl.textContent = 'Microphone permission denied.';
        stopRecording();
      }
    };

    // Key fix: If browser stops after silence while isRecording is still true, restart immediately
    recognition.onend = () => {
      if (isRecording) {
        try { recognition.start(); } catch (e) {}
      } else {
        statusEl.textContent = 'Stopped';
        statusEl.className = 'status';
        interimEl.textContent = 'Live speech preview will appear here...';
      }
    };
  }

  function startRecording() {
    if (!recognition) return;
    isRecording = true;
    recordBtn.textContent = 'Stop Talking';
    recordBtn.classList.add('active');
    try { recognition.start(); } catch (e) {}
  }

  function stopRecording() {
    isRecording = false;
    recordBtn.textContent = 'Start Talking';
    recordBtn.classList.remove('active');
    if (recognition) {
      try { recognition.stop(); } catch (e) {}
    }
  }

  recordBtn.onclick = () => {
    if (isRecording) stopRecording();
    else startRecording();
  };

  // Initialize
  if (notes.length === 0) {
    createNote();
  } else {
    activeId = notes[0].id;
    loadActiveNote();
  }
</script>
</body>
</html>
